# Copie este arquivo para .env e preencha
# Tenant (Directory) ID do Azure AD onde os recursos vivem
AZURE_TENANT_ID=

# --- Identidade usada para LER o Azure ---
#   cli              — usuário logado no Azure CLI (padrão; uso interativo/local)
#   managed-identity — identidade gerenciada da VM via IMDS (execução agendada,
#                      sem usuário logado e sem segredo em disco)
#   default          — DefaultAzureCredential (env vars, depois MI, depois CLI)
AZE_AUTH_MODE=cli
# Client ID da identidade gerenciada ATRIBUÍDA PELO USUÁRIO.
# DEIXE VAZIO para usar a identidade gerenciada atribuída pelo SISTEMA (a da
# própria VM) — é o caso mais comum. Preencha somente se a identidade for
# atribuída pelo usuário ou se a VM tiver mais de uma identidade: o IMDS não
# adivinha qual usar.
AZE_CLIENT_ID=

# --- Formato de saída dos relatórios ---
# xlsx — apenas Excel
# csv  — apenas CSV (um arquivo por tabela; relatórios multi-abas geram um
#        arquivo por aba)
# both — os dois (padrão)
AZE_OUTPUT_FORMAT=both
# Separador de campos do CSV. Use ";" para abrir com duplo clique no Excel em
# locales que usam a vírgula como separador decimal (pt-BR).
AZE_CSV_DELIMITER=,

# --- Destino do upload (usado por `main.py --upload`) ---
# blob  — container do Azure Blob Storage (recomendado para execução agendada)
# share — Azure File Share
AZE_UPLOAD_TARGET=blob

# Conta de armazenamento de destino (vale para os dois destinos)
AZE_STORAGE_ACCOUNT=<sua-storage-account>

# --- Destino BLOB (AZE_UPLOAD_TARGET=blob) ---
# A identidade precisa do papel "Storage Blob Data Contributor" no container.
AZE_BLOB_CONTAINER=<seu-container>
# Prefixo (pasta virtual) dentro do container. Opcional.
AZE_BLOB_PREFIX=azure-estate

# --- Destino FILE SHARE (AZE_UPLOAD_TARGET=share) ---
# Destino: \\<conta>.file.core.windows.net\<share>\<caminho>
# Dois modos de autenticação (veja AZE_UPLOAD_AUTH_MODE abaixo):
#   login (padrão) — identidade Microsoft Entra (OAuth); requer o papel
#                    "Storage File Data Privileged Contributor".
#   key            — chave da conta obtida via ARM (funciona no Azure Cloud Shell).
#                    NÃO funciona com identidade gerenciada.
# (Os nomes antigos com prefixo ARI_ ainda são aceitos por compatibilidade.)
AZE_FILE_SHARE=<seu-file-share>
AZE_SHARE_PATH=<pasta/no/share>

# Modo de autenticação do upload: "login" (identidade Entra / OAuth) ou "key"
# (chave da conta obtida via ARM — funciona no Azure Cloud Shell, onde o token
# de data-plane storage.azure.com falha). O modo "key" exige permissão para
# listar chaves (Contributor / Storage Account Contributor).
AZE_UPLOAD_AUTH_MODE=login
# Usados apenas por AZE_UPLOAD_AUTH_MODE=key (opcionais; a CLI resolve o RG e
# usa a subscription ativa se não informados):
AZE_RESOURCE_GROUP=
AZE_SUBSCRIPTION=
