# Copie este arquivo para .env e preencha
# Tenant (Directory) ID do Azure AD onde os recursos vivem
AZURE_TENANT_ID=

# --- Upload para Azure File Share (opcional, usado por `main.py --upload`) ---
# Destino: \\<conta>.file.core.windows.net\<share>\<caminho>
# Dois modos de autenticação (veja AZE_UPLOAD_AUTH_MODE abaixo):
#   login (padrão) — identidade Microsoft Entra do usuário logado (OAuth); requer
#                     o papel "Storage File Data Privileged Contributor".
#   key            — chave da conta obtida via ARM (funciona no Azure Cloud Shell).
# (Os nomes antigos com prefixo ARI_ ainda são aceitos por compatibilidade.)
AZE_STORAGE_ACCOUNT=<sua-storage-account>
AZE_FILE_SHARE=<seu-file-share>
AZE_SHARE_PATH=<pasta/no/share>

# Modo de autenticação do upload: "login" (identidade Entra / OAuth) ou "key"
# (chave da conta obtida via ARM — funciona no Azure Cloud Shell, onde o token
# de data-plane storage.azure.com falha). O modo "key" exige permissão para
# listar chaves (Contributor / Storage Account Contributor).
AZE_UPLOAD_AUTH_MODE=login
# Usados apenas por AZE_UPLOAD_AUTH_MODE=key (opcionais; a CLI resolve o RG e
# usa a subscription ativa se não informados):
AZE_RESOURCE_GROUP=
AZE_SUBSCRIPTION=
